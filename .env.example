# Telegram delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Live tracker polling interval (seconds)
POLL_INTERVAL_SEC=60

# LiteLLM gateway (cluster) — used only by `analysis` (LLM post-match analysis).
# Defaults point at the cluster's own gateway; override for local dev.
LITELLM_BASE_URL=https://litellm.antonio-code.duckdns.org/v1
LITELLM_API_KEY=
LITELLM_MODEL=cloud/gpt-oss-120b
